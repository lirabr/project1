# Copy to .env (never commit .env). Paper-only credentials.

# local databases (docker compose, see infra/docker-compose.yml)
DATABASE_URL=postgresql://desk:desk@localhost:5432/trading_desk
REDIS_URL=redis://localhost:6379/0

# alpaca PAPER only
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_PAPER=true

# binance TESTNET only (optional in phase 0)
BINANCE_TESTNET=true
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://testnet.binance.vision

